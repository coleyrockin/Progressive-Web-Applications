{
  "name": "jate",
  "version": "1.0.0",
  "description": "Professional-grade, offline-first text editor with PWA and local persistence.",
  "scripts": {
    "start:dev": "concurrently \"cd server && npm run server\" \"cd client && npm run dev\"",
    "start": "npm run build && node server/server.js",
    "server": "cd server && nodemon server.js --ignore client",
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.17.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "concurrently": "^5.2.0",
    "nodemon": "^2.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coleyrockin/Progressive-Web-Applications.git"
  },
  "author": "coleyrockin",
  "license": "ISC",
  "private": true,
  "bugs": {
    "url": "https://github.com/coleyrockin/Progressive-Web-Applications/issues"
  },
  "homepage": "https://github.com/coleyrockin/Progressive-Web-Applications#readme"
}
